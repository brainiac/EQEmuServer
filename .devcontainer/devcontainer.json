// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "eqemu",

	"appPort": [
		"5998:5998/udp",
		"7000:7000/udp",
		"7001:7001/udp",
		"7002:7002/udp",
		"7003:7003/udp",
		"7004:7004/udp",
		"7005:7005/udp",
		"9000:9000/udp",
		"9001:9001/udp"
	],
	"build": {
		"dockerfile": "Dockerfile.debian.dev",
		"args": {
			"REMOTE_USER": "${localEnv:USER}",
			"REMOTE_UID": "${localEnv:REMOTE_UID:1000}",
			"REMOTE_GID": "${localEnv:REMOTE_GID:1000}"
		},
		"target": "devcontainer",
		"context": ".."
	},

	"containerUser": "vscode",
	"forwardPorts": [
		3306
	],
	"remoteEnv": {
		"LOCALWSF": "${localWorkspaceFolder}",
		"CONTAINERWSF": "${containerWorkspaceFolder}"
	},
	"remoteUser": "${localEnv:USER}",
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"bibhasdn.unique-lines",
				"editorconfig.editorconfig",
				"GitHub.copilot",
				"Gruntfuggly.todo-tree",
				"maattdd.gitless",
				"ms-vscode.cmake-tools",
				"ms-vscode.cpptools-extension-pack",
				"sumneko.lua",
				"vilicvane.sensitive-replace",
				"xackery.make-magic"
			],
			"settings": {
				"cmake.configureOnOpen": false,
				"cmake.skipConfigureIfCachePresent": true,
				"files.watcherExclude": {
					"submodules/vcpkg/**": true
				},
				"Lua.runtime.version": "Lua 5.1",
				"Lua.workspace.library": [
					"/src/repo/eqemu-definitions"
				],
				"Lua.diagnostics.disable": [
					"lowercase-global"
				]
			}
		}
	},
	"mounts": [
		"source=${localWorkspaceFolder}/.devcontainer/Makefile,target=/src/Makefile,type=bind,consistency=cached"
	],

	"workspaceFolder": "/src",
	"workspaceMount": "source=${localWorkspaceFolder},target=/src,type=bind,consistency=cached"
}
